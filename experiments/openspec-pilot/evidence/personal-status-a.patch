+    def status(
+        self, *selection: str, target: str = "codex", json_output: bool = True
+    ) -> tuple[int, str, str]:
+        """Capture a status CLI call against the isolated package and home."""
+        output, errors = io.StringIO(), io.StringIO()
+        arguments = ["status", "--target", target, "--home", str(self.home), *selection]
+        if json_output:
+            arguments.append("--json")
+        with (
+            patch.object(install, "ROOT", self.root),
+            contextlib.redirect_stdout(output),
+            contextlib.redirect_stderr(errors),
+        ):
+            result = install.main(arguments)
+        return result, output.getvalue(), errors.getvalue()
