+    def test_status_role_requires_current_source_inode_and_regular_file(self) -> None:
+        """Copies, runtime-incompatible symlinks and stale equal-byte hardlinks differ."""
+        self.apply()
+        source = self.root / "agents/codex/documentation-agent.toml"
+        role = self.codex / "agents/documentation-agent.toml"
+        for kind in ("copy", "symlink", "stale-hardlink"):
+            with self.subTest(kind=kind):
+                role.unlink()
+                if kind == "copy":
+                    shutil.copyfile(source, role)
+                elif kind == "symlink":
+                    role.symlink_to(source)
+                else:
+                    os.link(source, role)
+                    replacement = source.with_suffix(".replacement")
+                    replacement.write_bytes(source.read_bytes())
+                    replacement.replace(source)
+                self.assertEqual(role.read_bytes(), source.read_bytes())
+                before = (role.lstat().st_ino, role.lstat().st_mtime_ns)
+                result, output, _ = self.status("--skill", "documentation-skill")
+                self.assertEqual(result, 1)
+                entries = json.loads(output)["entries"]
+                self.assertEqual(entries[0]["state"], "different")
+                self.assertEqual({entry["state"] for entry in entries[1:]}, {"current"})
+                self.assertEqual((role.lstat().st_ino, role.lstat().st_mtime_ns), before)
