+def inspect_installation(
+    root: Path, target: str, skills: list[str], home: Path, codex_home: Path
+) -> list[dict[str, str]]:
+    """Report selected canonical destinations using linkage identity, without writes.
+
+    Skills must be symbolic links to the current source directory. Codex roles
+    must be regular files sharing the current source inode; matching bytes alone
+    cannot establish linkage or permission to replace an entry. Legacy and
+    unselected entries and restoration receipts are outside this inspection.
+    """
+    selected = resolve_selection(skills, inventory(root))
+    paths = locations(home, codex_home)
+    expected = {(f"{target}-skills", name): root / "skills" / name for name in selected}
+    for name in selected:
+        for agent in AGENTS[target].get(name, []):
+            expected[f"{target}-agents", agent] = root / "agents" / target / agent
+    entries = []
+    for (area, name), source in sorted(expected.items()):
+        destination = paths[area] / name
+        check_parents(destination.parent)
+        try:
+            mode = destination.lstat().st_mode
+        except FileNotFoundError:
+            state = "missing"
+        else:
+            correct_type = stat.S_ISREG(mode) if area == "codex-agents" else stat.S_ISLNK(mode)
+            state = "current" if correct_type and linked_to(destination, source) else "different"
+        entries.append({"area": area, "name": name, "state": state})
+    return entries
+
