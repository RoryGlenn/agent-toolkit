+def check_project(project: Path) -> None:
+    """Inspect recorded ownership and content without consulting current toolkit sources.
+
+    Only hashes recorded by the installation are authoritative here. Unowned files
+    and instructions outside the managed AGENTS.md block are deliberately ignored.
+    """
+    project = Path(os.path.abspath(project.expanduser()))
+    check_ancestors(project)
+    manifest_path = project / MANIFEST
+    recorded = read_file(manifest_path)
+    if recorded is None:
+        raise BootstrapError(f"Project is not bootstrapped; missing manifest: {manifest_path}")
+    try:
+        manifest = validate_manifest(recorded.content)
+    except (ValueError, TypeError) as error:
+        raise BootstrapError(f"Invalid project manifest {manifest_path}: {error}") from error
+    problems = []
+    for name, fingerprint in sorted(manifest["files"].items()):
+        path = project / name
+        try:
+            current = read_file(path)
+            if current is None:
+                problems.append(f"Missing managed file: {name}")
+            elif digest(current.content) != fingerprint:
+                problems.append(f"Edited managed file: {name}")
+        except (OSError, BootstrapError) as error:
+            problems.append(f"Unsafe or unreadable managed file {name}: {error}")
+    try:
+        instructions = read_file(project / "AGENTS.md")
+        span = block_span(instructions.content) if instructions else None
+        if span is None:
+            problems.append("Missing managed AGENTS.md routing block.")
+        elif (
+            instructions is not None
+            and digest(instructions.content[span[0] : span[1]]) != manifest["agents_block_sha256"]
+        ):
+            problems.append("Modified managed AGENTS.md routing block.")
+    except (OSError, BootstrapError) as error:
+        problems.append(f"Invalid managed AGENTS.md routing block: {error}")
+    if problems:
+        raise BootstrapError("Project toolkit integrity check failed:\n" + "\n".join(problems))
+    print(
+        f"Project toolkit integrity intact: {len(manifest['files'])} managed files "
+        "and routing block."
+    )
+
+
