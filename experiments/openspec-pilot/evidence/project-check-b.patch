+    def test_check_intact_ignores_unowned_content_and_source_changes(self) -> None:
+        """Recorded bytes remain intact even when the available toolkit changes or disappears."""
+        self.apply(skills=["documentation-skill"], target="codex")
+        instructions = self.app / "AGENTS.md"
+        instructions.write_bytes(b"Team prefix\n" + instructions.read_bytes() + b"Team suffix\n")
+        (self.app / ".agents/skills/documentation-skill/team.md").write_text("Unowned guidance")
+        # A checker must not validate, import, or render the current source packages.
+        shutil.rmtree(self.source / "skills")
+        shutil.rmtree(self.source / "agents")
+        before = self.snapshot()
+        source_before = {path.relative_to(self.source) for path in self.source.rglob("*")}
+        result = self.check_cli()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn("integrity intact", result.stdout)
+        self.assertEqual(self.snapshot(), before)
+        self.assertEqual(
+            {path.relative_to(self.source) for path in self.source.rglob("*")}, source_before
+        )
+
+    def test_check_missing_target_and_unbootstrapped_directory_do_not_write(self) -> None:
+        """Inspection never creates a missing application or adopts an existing directory."""
+        result = self.check_cli()
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("not bootstrapped", result.stderr)
+        self.assertFalse(self.app.exists())
+        self.app.mkdir()
+        (self.app / "AGENTS.md").write_text("Team instructions")
+        before = self.snapshot()
+        result = self.check_cli()
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("missing manifest", result.stderr)
+        self.assertEqual(self.snapshot(), before)
+
+    def test_check_reports_edited_missing_files_and_block_together_without_writes(self) -> None:
+        """One inspection identifies every owned content failure, including the routing block."""
+        self.apply(skills=["documentation-skill"], target="codex")
+        edited = ".agents/skills/documentation-skill/SKILL.md"
+        missing = ".codex/agents/documentation-agent.toml"
+        (self.app / edited).write_text("Team customization")
+        (self.app / missing).unlink()
+        instructions = self.app / "AGENTS.md"
+        original = instructions.read_bytes()
+        for content, expected in (
+            (original.replace(b"Shared engineering", b"Changed engineering"), "Modified"),
+            (b"Team instructions only\n", "Missing"),
+            (original + project.BLOCK_START, "Invalid"),
+        ):
+            with self.subTest(block=expected):
+                instructions.write_bytes(content)
+                before = self.snapshot()
+                result = self.check_cli()
+                self.assertNotEqual(result.returncode, 0)
+                self.assertIn(f"Edited managed file: {edited}", result.stderr)
+                self.assertIn(f"Missing managed file: {missing}", result.stderr)
+                self.assertIn(f"{expected} managed AGENTS.md routing block", result.stderr)
+                self.assertEqual(self.snapshot(), before)
+        instructions.unlink()
+        result = self.check_cli()
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("Missing managed AGENTS.md routing block", result.stderr)
+
+    def test_check_rejects_malformed_and_unsafe_manifest_without_writes(self) -> None:
+        """The recorded path boundary and hash schema are validated before owned reads."""
+        self.apply(skills=["documentation-skill"], target="codex")
+        manifest_path = self.app / project.MANIFEST
+        original = json.loads(manifest_path.read_bytes())
+        variants = [
+            b"not JSON",
+            b"[]",
+            # Ambiguous duplicate fields must not silently replace ownership data.
+            b'{"schema": "invalid", "schema": "agent-toolkit-project/v1"}',
+        ]
+        for key, value in (
+            ("schema", "future"),
+            ("skills", ["../unsafe-skill"]),
+            ("hosts", ["unknown"]),
+            ("files", {}),
+            ("files", {"../../outside": "0" * 64}),
+            ("files", {".agents/skills/documentation-skill/SKILL.md": "bad hash"}),
+            ("agents_block_sha256", None),
+        ):
+            changed = dict(original)
+            changed[key] = value
+            variants.append(json.dumps(changed).encode())
+        for content in variants:
+            with self.subTest(content=content[:120]):
+                manifest_path.write_bytes(content)
+                before = self.snapshot()
+                result = self.check_cli()
+                self.assertNotEqual(result.returncode, 0)
+                self.assertIn("Invalid project manifest", result.stderr)
+                self.assertNotIn("Traceback", result.stderr)
+                self.assertEqual(self.snapshot(), before)
+
