+    def test_json_catalog_schema_and_live_associations(self) -> None:
+        """Machine output exposes canonical metadata, direct dependencies and runtime roles."""
+        data = json.loads(self.list_catalog("--json"))
+        self.assertEqual(set(data), {"schema_version", "skills"})
+        self.assertEqual(data["schema_version"], 1)
+        skills = install.inventory(self.root)
+        self.assertEqual([entry["name"] for entry in data["skills"]], sorted(skills))
+        entries = {entry["name"]: entry for entry in data["skills"]}
+        for entry in data["skills"]:
+            self.assertEqual(set(entry), {"name", "description", "dependencies", "roles"})
+            self.assertEqual(entry["description"], skills[entry["name"]])
+            self.assertEqual(entry["dependencies"], sorted(entry["dependencies"]))
+            self.assertEqual(set(entry["roles"]), set(install.AGENTS))
+            self.assertEqual(entry["roles"]["copilot"], [])
+        self.assertEqual(entries["task-routing-skill"]["dependencies"], [])
+        self.assertEqual(
+            entries["ddia-design-skill"]["dependencies"], ["ddia-skill", "task-routing-skill"]
+        )
+        self.assertEqual(entries["documentation-skill"]["dependencies"], ["task-routing-skill"])
+        self.assertEqual(entries["release-and-docs-skill"]["roles"], {"codex": [], "copilot": []})
+        self.assertEqual(entries["ddia-design-skill"]["roles"]["codex"], ["ddia_agent"])
+        self.assertEqual(
+            entries["issue-to-tested-pr-skill"]["roles"]["codex"],
+            ["adversarial_reviewer_agent", "implementation_owner_agent", "verifier_agent"],
+        )
+        self.assertFalse(self.home.exists())
+
+    def test_json_catalog_sorts_current_associations_and_keeps_dependencies_direct(self) -> None:
+        """Output follows current mappings while sorting lists and avoiding dependency closure."""
+        workflow = "issue-to-tested-pr-skill"
+        with (
+            patch.dict(
+                install.AGENTS["codex"],
+                {workflow: list(reversed(install.AGENTS["codex"][workflow]))},
+            ),
+            patch.dict(
+                "project_bootstrap.SKILL_DEPENDENCIES",
+                {
+                    workflow: ("task-routing-skill", "documentation-skill"),
+                    "documentation-skill": ("ddia-skill",),
+                },
+            ),
+        ):
+            entries = {
+                entry["name"]: entry for entry in json.loads(self.list_catalog("--json"))["skills"]
+            }
+        self.assertEqual(
+            entries[workflow]["dependencies"], ["documentation-skill", "task-routing-skill"]
+        )
+        roles = entries[workflow]["roles"]["codex"]
+        self.assertEqual(roles, sorted(roles))
+        self.assertNotIn("ddia-skill", entries[workflow]["dependencies"])
+
+    def test_json_catalog_rejects_invalid_sources_without_partial_stdout(self) -> None:
+        """A broken runtime role cannot become a seemingly valid machine-readable catalog."""
+        path = self.root / "agents/codex/documentation-agent.toml"
+        path.write_text(path.read_text().replace("documentation_agent", "invalid_agent"))
+        output, errors = io.StringIO(), io.StringIO()
+        with (
+            patch.object(install, "ROOT", self.root),
+            contextlib.redirect_stdout(output),
+            contextlib.redirect_stderr(errors),
+        ):
+            self.assertEqual(install.main(["list", "--json"]), 1)
+        self.assertEqual(output.getvalue(), "")
+        self.assertIn("name must match its filename", errors.getvalue())
+        self.assertFalse(self.home.exists())
+
+    def test_json_catalog_fresh_process_is_read_only(self) -> None:
+        """A CLI process emits only JSON and creates neither bytecode nor host directories."""
+        for filename in ("install.py", "project_bootstrap.py"):
+            shutil.copyfile(ROOT / filename, self.root / filename)
+        before = set(self.base.rglob("*"))
+        environment = {
+            key: value
+            for key, value in os.environ.items()
+            if key not in {"PYTHONDONTWRITEBYTECODE", "PYTHONPYCACHEPREFIX"}
+        }
+        environment.update({"HOME": str(self.home), "CODEX_HOME": str(self.codex)})
+        result = subprocess.run(
+            [sys.executable, str(self.root / "install.py"), "list", "--json"],
+            cwd=self.base,
+            env=environment,
+            capture_output=True,
+            text=True,
+            check=False,
+        )
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stderr, "")
+        self.assertEqual(json.loads(result.stdout)["schema_version"], 1)
+        self.assertEqual(set(self.base.rglob("*")), before)
+        self.assertFalse(self.home.exists())
+
